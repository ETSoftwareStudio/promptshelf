{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bootstrap-sha": "306432b",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    }
  ],
  "packages": {
    ".": {
      "extra-files": [
        "Cargo.toml",
        {
          "type": "json",
          "path": "npm/promptshelf/package.json",
          "jsonpath": "$.version"
        },
        "app/src-tauri/Cargo.toml",
        {
          "type": "json",
          "path": "app/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
